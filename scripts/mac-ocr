#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
mac-ocr — macOS 本地 OCR 三件套 · 统一命令行

子命令：
  setup            一键安装/修复（Tesseract + 标准版中文语言包 + Apple Vision + rapidocr）
  check            体检三件套就绪状态

示例：
  mac-ocr setup
  mac-ocr check

说明：
  - 本 CLI 仅依赖 Python 标准库（argparse/subprocess/urllib 等），系统 python3 直接可跑
  - OCR 引擎需 pyobjc（Vision 框架），setup 会建专用 venv；识别命令 vision-ocr 自动用 venv python 重启
  - 识别请用配套独立命令 vision-ocr（由 setup 部署到 ~/.local/bin，任意目录可用）
  - mac-ocr 本身是安装/体检脚本，不进 PATH
  - --bypass 等外部注入的确认参数会被静默忽略，不影响使用
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import urllib.request

VERSION = "0.1.0"

# ─── 路径与环境常量 ───────────────────────────────────────────────
# 安装路径默认中性化（XDG 惯例），可用环境变量覆盖：
#   MAC_OCR_VENV_DIR  pyobjc 专用 venv 目录（默认 ~/.local/share/mac-ocr/venv）
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
SKILL_ROOT = os.path.dirname(SCRIPT_DIR)
VENV_DIR = os.environ.get("MAC_OCR_VENV_DIR", os.path.expanduser("~/.local/share/mac-ocr/venv"))
VENV_PY3 = os.path.join(VENV_DIR, "bin", "python3")
def _default_tessdata_dir() -> str:
    """动态探测 Homebrew prefix 下的 tessdata 目录（Apple Silicon: /opt/homebrew，Intel: /usr/local）。"""
    try:
        p = subprocess.run(["brew", "--prefix"], capture_output=True, text=True, timeout=15)
        if p.returncode == 0 and p.stdout.strip():
            return os.path.join(p.stdout.strip(), "share", "tessdata")
    except Exception:
        pass
    return "/opt/homebrew/share/tessdata"


TESSDATA_DIR = os.environ.get("TESSDATA_DIR") or _default_tessdata_dir()
UPSTREAM = "https://raw.githubusercontent.com/tesseract-ocr/tessdata/main"
MIRRORS = ["https://ghfast.top", "https://gh-proxy.com"]
LANGS = ["chi_sim", "chi_sim_vert", "chi_tra", "chi_tra_vert"]

IN_VENV = os.environ.get("MAC_OCR_IN_VENV") == "1"

# ─── 基础工具函数 ────────────────────────────────────────────────
def need(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def run(cmd) -> int:
    """执行外部命令，返回 returncode（不抛异常；成败由调用方判断并提示）。"""
    return subprocess.run(cmd).returncode


def run_capture(cmd):
    """执行命令并返回 (returncode, stdout)。"""
    p = subprocess.run(cmd, capture_output=True, text=True)
    return p.returncode, (p.stdout or "").strip()


def human_size(path: str) -> str:
    try:
        n = os.path.getsize(path)
    except OSError:
        return "?"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.1f}{unit}" if unit != "B" else f"{n}B"
        n /= 1024
    return f"{n:.1f}TB"


# ─── setup：安装/修复 ────────────────────────────────────────────
def probe_size(url: str, timeout: int = 15) -> str:
    """GET + Range 探测远端文件总大小（读 Content-Range），拿不到返回空串。"""
    try:
        req = urllib.request.Request(url, headers={"Range": "bytes=0-1023"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            cr = resp.headers.get("Content-Range", "") or ""
        m = re.search(r"/(\d+)\s*$", cr.strip())
        return m.group(1) if m else ""
    except Exception:
        return ""


def pick_mirror() -> str:
    """按 MIRRORS 优先级探测可用镜像；环境变量 MAC_OCR_MIRROR_URL 可强制指定。"""
    override = os.environ.get("MAC_OCR_MIRROR_URL")
    if override:
        return override
    for m in MIRRORS:
        if probe_size(f"{m}/{UPSTREAM}/osd.traineddata"):
            return m
    return ""


def download(url: str, dest: str, min_bytes: int = 1_000_000) -> bool:
    """原子下载 + 最小尺寸校验：先写 .part，大小达标再 rename；失败清掉半截文件。

    min_bytes 拦截镜像返回 200 错误页（通常几 KB）被存成坏 traineddata 的情况；
    本项目语言包最小约 2.3MB，1MB 阈值安全。
    """
    part = dest + ".part"
    p = subprocess.run(
        ["curl", "-fsSL", "--retry", "3", "--retry-delay", "2", "-o", part, url],
        capture_output=True,
    )
    size = os.path.getsize(part) if os.path.isfile(part) else 0
    if p.returncode == 0 and size >= min_bytes:
        os.replace(part, dest)
        return True
    if os.path.isfile(part):
        os.remove(part)
    return False


def setup_tesseract(force=False):
    print("---------- [1/3] Tesseract + 中文语言包 ----------")
    if need("tesseract"):
        out = subprocess.run(["tesseract", "--version"], capture_output=True, text=True)
        ver = (out.stdout or out.stderr).splitlines()[0] if (out.stdout or out.stderr) else "?"
        print(f"✔ tesseract 已装 ({ver})")
    else:
        print("↓ 安装 tesseract ...")
        if run(["brew", "install", "tesseract"]) != 0:
            print("✘ tesseract 安装失败（检查 Homebrew / 网络后重跑）")
            return False

    print("↓ 探测语言包镜像 ...")
    base = pick_mirror()
    if not base:
        print("✘ 镜像不可达，可设 --mirror-url 或 MAC_OCR_MIRROR_URL=<镜像> 重试")
        return False
    print(f"  使用镜像: {base}")

    os.makedirs(TESSDATA_DIR, exist_ok=True)
    ok = True
    for lang in LANGS:
        dest = os.path.join(TESSDATA_DIR, f"{lang}.traineddata")
        if not force and os.path.isfile(dest) and os.path.getsize(dest) > 0:
            print(f"✔ {lang} 已有 ({human_size(dest)})")
            continue
        print(f"↓ {lang} 下载中 ...")
        if download(f"{base}/{UPSTREAM}/{lang}.traineddata", dest):
            print(f"✔ {lang} OK ({human_size(dest)})")
        else:
            print(f"✘ {lang} 下载失败")
            ok = False
    return ok


def setup_vision():
    print("---------- [2/3] Apple Vision ----------")
    venv_py = VENV_PY3
    if os.path.isfile(venv_py) and _venv_has_vision(venv_py):
        print(f"✔ Apple Vision 已就绪（venv: {VENV_DIR}）")
    else:
        print("↓ 搭建 venv + pyobjc ...")
        if not os.path.isfile(venv_py):
            os.makedirs(os.path.dirname(VENV_DIR), exist_ok=True)
            if run(["uv", "venv", VENV_DIR]) != 0:
                print("✘ uv venv 创建失败")
                return False
        if run([
            "uv", "pip", "install", "--python", venv_py,
            "pyobjc-framework-Vision", "pyobjc-framework-Quartz",
            "pyobjc-framework-Cocoa",
        ]) != 0:
            print("✘ pyobjc 安装失败（检查网络后重跑）")
            return False
        if not _venv_has_vision(venv_py):
            print("✘ venv 建好但 Vision 不可用")
            return False

    return True


VISION_CMD_DIR = os.path.expanduser("~/.local/bin")


def setup_vision_cmd() -> bool:
    """部署全局识别命令 vision-ocr：软链 scripts/vision-ocr -> ~/.local/bin/vision-ocr。

    定位：mac-ocr 是安装/体检脚本，不进 PATH；vision-ocr 是独立识别命令，
    由 setup 软链到 ~/.local/bin（PATH 内），任意目录直接 vision-ocr 图片.png。
    """
    src = os.path.join(SCRIPT_DIR, "vision-ocr")
    if not os.path.isfile(src):
        print(f"✘ 找不到 {src}（vision-ocr 脚本缺失）")
        return False
    os.makedirs(VISION_CMD_DIR, exist_ok=True)
    cmd_path = os.path.join(VISION_CMD_DIR, "vision-ocr")
    try:
        if os.path.islink(cmd_path) or os.path.isfile(cmd_path):
            os.remove(cmd_path)
        os.symlink(src, cmd_path)
    except OSError as e:
        print(f"✘ 创建软链失败: {e}")
        return False
    print(f"✔ 全局识别命令已生成: {cmd_path}")
    return True


def _venv_has_vision(venv_py: str) -> bool:
    p = subprocess.run([venv_py, "-c", "import Vision"], capture_output=True)
    return p.returncode == 0


def setup_rapidocr():
    print("---------- [3/3] rapidocr（PP-OCR + onnxruntime） ----------")
    if _rapidocr_ok():
        print("✔ rapidocr 已就绪（含 onnxruntime 引擎）")
        return True
    print("↓ 安装/修复 rapidocr ...")
    if run(["uv", "tool", "install", "rapidocr", "--with", "onnxruntime"]) != 0:
        print("✘ rapidocr 安装失败（检查网络后重跑）")
        return False
    if _rapidocr_ok():
        print("✔ rapidocr 完成")
        return True
    print("✘ rapidocr 安装后仍异常")
    return False


def _rapidocr_ok() -> bool:
    if not need("rapidocr"):
        return False
    rc, out = run_capture(["uv", "tool", "dir"])
    if rc != 0 or not out:
        return False
    py = os.path.join(out, "rapidocr", "bin", "python")
    if not os.path.isfile(py):
        return False
    p = subprocess.run([py, "-c", "import onnxruntime"], capture_output=True)
    return p.returncode == 0


def cmd_setup(args):
    # 安装路径：默认 ~/.local/share/mac-ocr/venv；
    # 高级用法可 export MAC_OCR_VENV_DIR 覆盖（初始化时读取，识别/体检同源）
    print("===== mac-ocr · 一键安装 =====")
    print("将安装到以下路径:")
    print(f"  - Python venv          → {VENV_DIR}")
    print(f"  - 全局识别命令 vision-ocr → {VISION_CMD_DIR}/vision-ocr")
    print()

    if not need("brew"):
        print("✘ 需要 Homebrew（https://brew.sh）")
        return 1
    if not need("uv"):
        print("✘ 需要 uv（curl -LsSf https://astral.sh/uv/install.sh | sh）")
        return 1

    ok = True
    ok &= setup_tesseract(force=args.force)
    ok &= setup_vision()
    ok &= setup_vision_cmd()
    ok &= setup_rapidocr()

    print()
    print("===== 安装完成 =====")
    print("体检:        mac-ocr check")
    print("识别:        vision-ocr 图片.png")
    if not ok:
        print("⚠️ 存在未完成项，请 mac-ocr check 确认")
        return 1
    return 0


# ─── check：体检 ────────────────────────────────────────────────
def cmd_check(args):
    failed = False
    print("======================================")
    print(" macOS 本地 OCR 三件套 · 就绪检查")
    print("======================================")

    # 1) tesseract
    if need("tesseract"):
        out = subprocess.run(["tesseract", "--version"], capture_output=True, text=True)
        ver = (out.stdout or out.stderr).splitlines()[0] if (out.stdout or out.stderr) else "?"
        print(f"✅ tesseract       {ver}")
        rc, langs = run_capture(["tesseract", "--list-langs"])
        chi = [l for l in langs.splitlines() if l.startswith("chi")]
        if chi:
            print("   中文语言包:")
            for l in chi:
                print(f"     - {l}")
        else:
            print("    ⚠️ 无中文语言包（跑 mac-ocr setup 下载标准版）")
    else:
        print("❌ tesseract       未安装（brew install tesseract）")
        failed = True

    # 2) Apple Vision（引擎：venv + pyobjc）
    if os.path.isfile(VENV_PY3) and _venv_has_vision(VENV_PY3):
        print(f"✅ Apple Vision   {VENV_PY3} 可用")
    elif os.path.isfile(VENV_PY3):
        print("⚠️ Apple Vision   venv 存在但 Vision 不可用（跑 mac-ocr setup 修复）")
    else:
        print("❌ Apple Vision    未安装（跑 mac-ocr setup）")
        failed = True

    # 2.5) vision-ocr 全局识别命令
    vcmd = os.path.join(VISION_CMD_DIR, "vision-ocr")
    if os.path.isfile(vcmd) and os.access(vcmd, os.X_OK):
        print(f"✅ vision-ocr     {vcmd}")
    else:
        print("❌ vision-ocr       未安装（跑 mac-ocr setup 生成）")
        failed = True

    # 3) rapidocr
    if need("rapidocr"):
        print("✅ rapidocr        已安装")
        rc, out = run_capture(["uv", "tool", "dir"])
        py = os.path.join(out, "rapidocr", "bin", "python") if rc == 0 and out else ""
        if py and os.path.isfile(py):
            p = subprocess.run([py, "-c", "import onnxruntime"], capture_output=True)
            print("   ✅ onnxruntime 引擎 OK" if p.returncode == 0
                  else "   ⚠️ onnxruntime 缺失！修复：uv tool install rapidocr --with onnxruntime")
        else:
            print("   ⚠️ 无法定位 uv tool 环境")
    else:
        print("❌ rapidocr         未安装（uv tool install rapidocr --with onnxruntime）")
        failed = True

    print("======================================")
    print("提示：缺失项跑 mac-ocr setup 一键安装")
    return 1 if failed else 0




# ─── CLI 入口 ───────────────────────────────────────────────────
_MAIN_EPILOG = """\
示例：
  mac-ocr check                          体检三件套就绪状态
  mac-ocr setup                          一键安装/修复（幂等，缺什么装什么）
  mac-ocr setup --force                  强制重下已存在的语言包
  mac-ocr setup --mirror-url https://gh-proxy.com   指定镜像（国内直连超时用）

说明：
  - 全部本地识别，不联网不上云；模型/语言包下载走国内镜像自动切换
  - 识别用配套独立命令 vision-ocr（mac-ocr setup 自动部署到 ~/.local/bin）
  - 外部环境注入的确认参数（如 --bypass=...）会被静默忽略，不影响使用
"""

_SETUP_EPILOG = """\
安装内容（全部幂等，可重复跑）：
  1. Tesseract（brew）+ 标准版中文语言包：chi_sim / chi_tra / 简体竖排 / 繁体竖排
  2. Apple Vision：venv + pyobjc（Vision/Quartz/Cocoa，AppKit 在 Cocoa 内）
  3. rapidocr：uv tool install rapidocr --with onnxruntime（必须带引擎，否则报
     ImportError: onnxruntime is not installed）

安装路径：
  pyobjc venv -> ~/.local/share/mac-ocr/venv
  高级用法：export MAC_OCR_VENV_DIR=<DIR> 覆盖（setup/识别/体检同源读取）

示例：
  mac-ocr setup
  mac-ocr setup --force
  mac-ocr setup --mirror-url https://gh-proxy.com
"""

def build_parser():
    fmt = argparse.RawDescriptionHelpFormatter
    parser = argparse.ArgumentParser(
        prog="mac-ocr",
        description=(
            "macOS 本地 OCR 三件套统一命令行：\n"
            "  Tesseract（通用兜底）· Apple Vision（零依赖）· "
            "rapidocr（PP-OCR，中文强）\n"
            "完全本地、隐私安全。一个命令搞定 安装 / 体检；"
            "识别请用配套命令 vision-ocr（setup 自动部署到 PATH）。"
        ),
        epilog=_MAIN_EPILOG,
        formatter_class=fmt,
    )
    parser.add_argument("--version", action="version", version=f"mac-ocr {VERSION}")
    parser.add_argument("--bypass", default=None, help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="cmd", metavar="<子命令>")

    p_setup = sub.add_parser(
        "setup",
        help="一键安装/修复三件套（幂等）",
        description=(
            "一键安装/修复 macOS 本地 OCR 三件套。幂等设计："
            "缺什么装什么，已就绪的自动跳过，可反复运行。"
        ),
        epilog=_SETUP_EPILOG,
        formatter_class=fmt,
    )
    p_setup.add_argument("--force", action="store_true",
                         help="强制重下已存在的语言包（默认已有则跳过）")
    p_setup.add_argument("--mirror-url", default=None, metavar="URL",
                         help="指定语言包下载镜像前缀（默认自动探测 ghfast.top / gh-proxy.com）")
    p_setup.add_argument("--bypass", default=None, help=argparse.SUPPRESS)

    p_check = sub.add_parser(
        "check",
        help="体检三件套就绪状态",
        description=(
            "逐项检查三件套就绪状态：\n"
            "  Tesseract（含标准版中文语言包）/ Apple Vision"
            "/ rapidocr（含 onnxruntime 引擎）\n"
            "每项输出 ✅ / ❌ / ⚠️，并给出缺失时的修复提示。\n"
            "退出码：0 就绪（可含 ⚠️）/ 1 存在缺失项（❌）。"
        ),
        formatter_class=fmt,
    )
    p_check.add_argument("--bypass", default=None, help=argparse.SUPPRESS)

    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    parser = build_parser()
    args = parser.parse_args(argv)

    mirror_url = getattr(args, "mirror_url", None)
    if mirror_url:
        os.environ["MAC_OCR_MIRROR_URL"] = mirror_url

    if args.cmd == "setup":
        return cmd_setup(args)
    if args.cmd == "check":
        return cmd_check(args)

    parser.print_help()
    if args.cmd is None and argv:
        print("提示：识别请用配套命令 vision-ocr（如 vision-ocr 图片.png）", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
