#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
mac-ocr — macOS 本地 OCR 三件套 · 统一命令行

子命令：
  setup            一键安装/修复（Tesseract + 标准版中文语言包 + vision-ocr + rapidocr）
  check            体检三件套就绪状态
  ocr <图片>        用 Apple Vision 识别（等价旧 vision-ocr 工具）

示例：
  mac-ocr setup
  mac-ocr check
  mac-ocr ocr 图片.png --json
  mac-ocr 图片.png              # 省略子命令时按 ocr 处理

说明：
  - 本 CLI 仅依赖 Python 标准库（argparse/subprocess/urllib 等），系统 python3 直接可跑
  - OCR 引擎需 pyobjc（Vision 框架），setup 会建专用 venv；识别时自动用 venv python 重启
  - --bypass 等外部注入的确认参数会被静默忽略，不影响使用
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

VERSION = "1.0.0"

# ─── 路径与环境常量 ───────────────────────────────────────────────
# 安装路径默认中性化（XDG 惯例），可用环境变量覆盖：
#   MAC_OCR_BIN_DIR   vision-ocr 兼容命令安装目录（默认 ~/.local/bin）
#   MAC_OCR_VENV_DIR  pyobjc 专用 venv 目录（默认 ~/.local/share/mac-ocr/venv）
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
SKILL_ROOT = os.path.dirname(SCRIPT_DIR)
BIN_DIR = os.environ.get("MAC_OCR_BIN_DIR", os.path.expanduser("~/.local/bin"))
VENV_DIR = os.environ.get("MAC_OCR_VENV_DIR", os.path.expanduser("~/.local/share/mac-ocr/venv"))
VENV_PY3 = os.path.join(VENV_DIR, "bin", "python3")
TESSDATA_DIR = os.environ.get("TESSDATA_DIR", "/opt/homebrew/share/tessdata")
UPSTREAM = "https://raw.githubusercontent.com/tesseract-ocr/tessdata/main"
MIRRORS = ["https://ghfast.top", "https://gh-proxy.com"]
LANGS = ["chi_sim", "chi_sim_vert", "chi_tra", "chi_tra_vert"]

IN_VENV = os.environ.get("MAC_OCR_IN_VENV") == "1"

# 兼容 wrapper：部署到 BIN_DIR/vision-ocr，转发到本 CLI 的 ocr 子命令
VISION_WRAPPER = """#!/bin/sh
# Generated by mac-ocr setup - forwards to the unified CLI
exec "{cli}" ocr "$@"
""".format(cli=os.path.realpath(__file__))


# ─── 基础工具函数 ────────────────────────────────────────────────
def need(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def run(cmd, **kw):
    """subprocess.run 包装：默认合并输出为 utf-8 文本。"""
    kw.setdefault("check", True)
    return subprocess.run(cmd, **kw)


def run_capture(cmd):
    """执行命令并返回 (returncode, stdout)。"""
    p = subprocess.run(cmd, capture_output=True, text=True)
    return p.returncode, (p.stdout or "").strip()


def human_size(path: str) -> str:
    try:
        n = os.path.getsize(path)
    except OSError:
        return "?"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.1f}{unit}" if unit != "B" else f"{n}B"
        n /= 1024
    return f"{n:.1f}TB"


# ─── setup：安装/修复 ────────────────────────────────────────────
def probe_size(url: str, timeout: int = 15) -> str:
    """GET + Range 探测远端文件总大小（读 Content-Range），拿不到返回空串。"""
    try:
        req = urllib.request.Request(url, headers={"Range": "bytes=0-1023"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            cr = resp.headers.get("Content-Range", "") or ""
        m = re.search(r"/(\d+)\s*$", cr.strip())
        return m.group(1) if m else ""
    except Exception:
        return ""


def pick_mirror() -> str:
    """按 MIRRORS 优先级探测可用镜像；环境变量 BASE_URL 可强制指定。"""
    override = os.environ.get("BASE_URL")
    if override:
        return override
    for m in MIRRORS:
        if probe_size(f"{m}/{UPSTREAM}/osd.traineddata"):
            return m
    return ""


def download(url: str, dest: str) -> bool:
    p = subprocess.run(
        ["curl", "-fsSL", "--retry", "3", "--retry-delay", "2", "-o", dest, url],
        capture_output=True,
    )
    return p.returncode == 0


def setup_tesseract(force=False):
    print("---------- [1/4] Tesseract + 中文语言包 ----------")
    if need("tesseract"):
        out = subprocess.run(["tesseract", "--version"], capture_output=True, text=True)
        ver = (out.stdout or out.stderr).splitlines()[0] if (out.stdout or out.stderr) else "?"
        print(f"✔ tesseract 已装 ({ver})")
    else:
        print("↓ 安装 tesseract ...")
        run(["brew", "install", "tesseract"])

    print("↓ 探测语言包镜像 ...")
    base = pick_mirror()
    if not base:
        print("✘ 镜像不可达，可设 BASE_URL=<镜像> 重试")
        return False
    print(f"  使用镜像: {base}")

    os.makedirs(TESSDATA_DIR, exist_ok=True)
    ok = True
    for lang in LANGS:
        dest = os.path.join(TESSDATA_DIR, f"{lang}.traineddata")
        if not force and os.path.isfile(dest) and os.path.getsize(dest) > 0:
            print(f"✔ {lang} 已有 ({human_size(dest)})")
            continue
        print(f"↓ {lang} 下载中 ...")
        if download(f"{base}/{UPSTREAM}/{lang}.traineddata", dest):
            print(f"✔ {lang} OK ({human_size(dest)})")
        else:
            print(f"✘ {lang} 下载失败")
            ok = False
    return ok


def setup_vision():
    print("---------- [2/4] vision-ocr（Apple Vision） ----------")
    venv_py = VENV_PY3
    if os.path.isfile(venv_py) and _venv_has_vision(venv_py):
        print(f"✔ vision-ocr 已就绪（venv: {VENV_DIR}）")
    else:
        print("↓ 搭建 venv + pyobjc ...")
        if not os.path.isfile(venv_py):
            os.makedirs(os.path.dirname(VENV_DIR), exist_ok=True)
            run(["uv", "venv", VENV_DIR])
        run([
            "uv", "pip", "install", "--python", venv_py,
            "pyobjc-framework-Vision", "pyobjc-framework-Quartz",
            "pyobjc-framework-Cocoa",
        ])
        if not _venv_has_vision(venv_py):
            print("✘ venv 建好但 Vision 不可用")
            return False

    # 兼容 wrapper：BIN_DIR/vision-ocr -> mac-ocr ocr
    os.makedirs(BIN_DIR, exist_ok=True)
    wrapper = os.path.join(BIN_DIR, "vision-ocr")
    with open(wrapper, "w") as f:
        f.write(VISION_WRAPPER)
    os.chmod(wrapper, 0o755)
    print(f"✔ 兼容命令已生成: {wrapper}")
    return True


def _venv_has_vision(venv_py: str) -> bool:
    p = subprocess.run([venv_py, "-c", "import Vision"], capture_output=True)
    return p.returncode == 0


def setup_rapidocr():
    print("---------- [3/4] rapidocr（PP-OCR + onnxruntime） ----------")
    if _rapidocr_ok():
        print("✔ rapidocr 已就绪（含 onnxruntime 引擎）")
        return True
    print("↓ 安装/修复 rapidocr ...")
    run(["uv", "tool", "install", "rapidocr", "--with", "onnxruntime"])
    if _rapidocr_ok():
        print("✔ rapidocr 完成")
        return True
    print("✘ rapidocr 安装后仍异常")
    return False


def _rapidocr_ok() -> bool:
    if not need("rapidocr"):
        return False
    rc, out = run_capture(["uv", "tool", "dir"])
    if rc != 0 or not out:
        return False
    py = os.path.join(out, "rapidocr", "bin", "python")
    if not os.path.isfile(py):
        return False
    p = subprocess.run([py, "-c", "import onnxruntime"], capture_output=True)
    return p.returncode == 0


def cmd_setup(args):
    # 安装路径：命令行 --bin-dir / --venv-dir 覆盖（优先级最高），
    # 否则用环境变量 MAC_OCR_BIN_DIR / MAC_OCR_VENV_DIR，再否则用默认值
    global BIN_DIR, VENV_DIR, VENV_PY3
    if args.bin_dir:
        BIN_DIR = os.path.abspath(os.path.expanduser(args.bin_dir))
    if args.venv_dir:
        VENV_DIR = os.path.abspath(os.path.expanduser(args.venv_dir))
        VENV_PY3 = os.path.join(VENV_DIR, "bin", "python3")

    print("===== mac-ocr · 一键安装 =====")
    print("将安装到以下路径（如需修改：mac-ocr setup --bin-dir <目录> --venv-dir <目录>）:")
    print(f"  - 兼容命令 vision-ocr  → {BIN_DIR}/vision-ocr")
    print(f"  - Python venv          → {VENV_DIR}")
    print()

    if not need("brew"):
        print("✘ 需要 Homebrew（https://brew.sh）")
        return 1
    if not need("uv"):
        print("✘ 需要 uv（curl -LsSf https://astral.sh/uv/install.sh | sh）")
        return 1

    ok = True
    ok &= setup_tesseract(force=args.force)
    ok &= setup_vision()
    ok &= setup_rapidocr()

    print()
    print("===== 安装完成 =====")
    print("体检:        mac-ocr check")
    print("识别:        mac-ocr ocr 图片.png")
    print(f"兼容命令:    {BIN_DIR}/vision-ocr 图片.png")
    if args.bin_dir or args.venv_dir:
        print("⚠️ 本次使用了自定义路径，后续识别/体检请保持对应环境变量：")
        print(f"   export MAC_OCR_BIN_DIR={BIN_DIR}")
        print(f"   export MAC_OCR_VENV_DIR={VENV_DIR}")
        print("   （可写入 ~/.zshrc 永久生效）")
    if not ok:
        print("⚠️ 存在未完成项，请 mac-ocr check 确认")
        return 1
    return 0


# ─── check：体检 ────────────────────────────────────────────────
def cmd_check(args):
    print("======================================")
    print(" macOS 本地 OCR 三件套 · 就绪检查")
    print("======================================")

    # 1) tesseract
    if need("tesseract"):
        out = subprocess.run(["tesseract", "--version"], capture_output=True, text=True)
        ver = (out.stdout or out.stderr).splitlines()[0] if (out.stdout or out.stderr) else "?"
        print(f"✅ tesseract       {ver}")
        rc, langs = run_capture(["tesseract", "--list-langs"])
        chi = [l for l in langs.splitlines() if l.startswith("chi")]
        if chi:
            print("   中文语言包:")
            for l in chi:
                print(f"     - {l}")
        else:
            print("    ⚠️ 无中文语言包（跑 mac-ocr setup 下载标准版）")
    else:
        print("❌ tesseract       未安装（brew install tesseract）")

    # 2) vision-ocr
    wrapper = os.path.join(BIN_DIR, "vision-ocr")
    if os.path.isfile(wrapper) and os.access(wrapper, os.X_OK):
        print(f"✅ vision-ocr     {wrapper}")
        if not os.path.isfile(VENV_PY3):
            print("   ⚠️ venv 缺失，vision-ocr 可能无法运行（跑 mac-ocr setup）")
    else:
        print(f"❌ vision-ocr      未安装（{wrapper} 不存在，跑 mac-ocr setup）")

    # 3) rapidocr
    if need("rapidocr"):
        print("✅ rapidocr        已安装")
        rc, out = run_capture(["uv", "tool", "dir"])
        py = os.path.join(out, "rapidocr", "bin", "python") if rc == 0 and out else ""
        if py and os.path.isfile(py):
            p = subprocess.run([py, "-c", "import onnxruntime"], capture_output=True)
            print("   ✅ onnxruntime 引擎 OK" if p.returncode == 0
                  else "   ⚠️ onnxruntime 缺失！修复：uv tool install rapidocr --with onnxruntime")
        else:
            print("   ⚠️ 无法定位 uv tool 环境")
    else:
        print("❌ rapidocr         未安装（uv tool install rapidocr --with onnxruntime）")

    print("======================================")
    print("提示：缺失项跑 mac-ocr setup 一键安装")
    return 0


# ─── ocr：Apple Vision 引擎 ─────────────────────────────────────
def cmd_ocr(args):
    if not os.path.isfile(args.image):
        print(f"错误: 文件不存在 - {args.image}", file=sys.stderr)
        return 1

    if IN_VENV:
        return run_engine(args)

    # 非 venv：用 venv python 自我重启（引擎需要 pyobjc/Vision）
    if not os.path.isfile(VENV_PY3):
        print("✘ 需要先跑 mac-ocr setup 搭建 vision-ocr 环境", file=sys.stderr)
        return 1
    argv = [VENV_PY3, os.path.realpath(__file__), "ocr", args.image]
    if args.lang != "zh-Hans":
        argv += ["--lang", args.lang]
    if args.level != "fast":
        argv += ["--level", args.level]
    if args.json_output:
        argv += ["--json"]
    if args.debug:
        argv += ["--debug"]
    if args.debug_output:
        argv += ["--debug-output", args.debug_output]
    env = dict(os.environ, MAC_OCR_IN_VENV="1")
    p = subprocess.run(argv, env=env)
    return p.returncode


def run_engine(args):
    """OCR 引擎主体（仅在有 Vision 的 venv python 中执行）。"""
    import Vision
    from Foundation import NSURL
    from Quartz import CIImage

    LEVEL_FAST = 0
    LEVEL_ACCURATE = 1

    def do_ocr(image, lang="zh-Hans", extra_langs=None, level=LEVEL_FAST):
        request = Vision.VNRecognizeTextRequest.alloc().init()
        request.setRecognitionLevel_(level)
        languages = [lang] + (extra_langs or [])
        if "en-US" not in languages:
            languages.append("en-US")
        request.setRecognitionLanguages_(languages)
        request.setUsesLanguageCorrection_(True)
        handler = Vision.VNImageRequestHandler.alloc().initWithCIImage_options_(image, None)
        success, error = handler.performRequests_error_([request], None)
        if not success:
            return None, error
        results = request.results() or []
        texts = []
        for obs in results:
            bbox = obs.boundingBox()
            texts.append({
                "text": obs.text(),
                "confidence": float(obs.confidence()),
                "bbox": {
                    "x": float(bbox.origin.x),
                    "y": float(bbox.origin.y),
                    "width": float(bbox.size.width),
                    "height": float(bbox.size.height),
                },
            })
        return texts, None

    def ocr_image(image_path, lang="zh-Hans", level="fast"):
        url = NSURL.fileURLWithPath_(os.path.realpath(image_path))
        if not url:
            raise FileNotFoundError(f"找不到文件: {image_path}")
        image = CIImage.imageWithContentsOfURL_(url)
        if not image:
            raise ValueError(f"无法读取图片: {image_path}")
        if level == "accurate":
            results, error = do_ocr(image, lang, None, LEVEL_ACCURATE)
            if error:
                raise RuntimeError(f"OCR 执行失败: {error}")
            return results
        results, error = do_ocr(image, lang, None, LEVEL_FAST)
        if error:
            raise RuntimeError(f"OCR 执行失败: {error}")
        if results:
            avg_conf = sum(r["confidence"] for r in results) / len(results)
            if avg_conf < 0.3:
                results2, _ = do_ocr(image, lang, None, LEVEL_ACCURATE)
                if results2:
                    avg2 = sum(r["confidence"] for r in results2) / len(results2)
                    if avg2 > avg_conf:
                        return results2
        return results

    def debug_image(image_path, results, output_path=None):
        from Quartz import CIContext
        from AppKit import (NSImage, NSBitmapImageRep, NSBezierPath, NSColor)
        from CoreGraphics import CGRectMake

        url = NSURL.fileURLWithPath_(os.path.realpath(image_path))
        ci_image = CIImage.imageWithContentsOfURL_(url)
        extent = ci_image.extent()
        img_w, img_h = extent.size.width, extent.size.height
        ci_context = CIContext.context()
        cg_image = ci_context.createCGImage_fromRect_(ci_image, extent)
        ns_image = NSImage.alloc().initWithCGImage_size_(cg_image, extent.size)
        ns_image.lockFocus()
        color = NSColor.redColor()
        for item in results:
            bbox = item["bbox"]
            x = bbox["x"] * img_w
            y = (1.0 - bbox["y"] - bbox["height"]) * img_h
            w = bbox["width"] * img_w
            h = bbox["height"] * img_h
            path_obj = NSBezierPath.bezierPathWithRect_(CGRectMake(x, y, w, h))
            path_obj.setStrokeColor_(color)
            path_obj.setLineWidth_(2.0)
            path_obj.stroke()
        ns_image.unlockFocus()
        if not output_path:
            output_path = os.path.splitext(image_path)[0] + "_debug.png"
        tiff_data = ns_image.TIFFRepresentation()
        bitmap = NSBitmapImageRep.alloc().initWithData_(tiff_data)
        png_data = bitmap.representationUsingType_properties_(4, None)
        png_data.writeToFile_atomically_(output_path, True)
        print(f"调试图片已保存: {output_path}")

    try:
        results = ocr_image(args.image, lang=args.lang, level=args.level)
    except Exception as e:
        print(f"错误: {e}", file=sys.stderr)
        return 1

    if args.debug:
        debug_image(args.image, results, args.debug_output)

    if args.json_output:
        print(json.dumps(results, ensure_ascii=False, indent=2))
    else:
        for item in results:
            print(item["text"])
    return 0


# ─── CLI 入口 ───────────────────────────────────────────────────
_MAIN_EPILOG = """\
示例：
  mac-ocr check                          体检三件套就绪状态
  mac-ocr setup                          一键安装/修复（幂等，缺什么装什么）
  mac-ocr setup --force                  强制重下已存在的语言包
  mac-ocr setup --base-url https://gh-proxy.com   指定镜像（国内直连超时用）
  mac-ocr ocr 截图.png                   识别文字（默认中文+英文）
  mac-ocr ocr 截图.png --json            JSON 输出（含置信度/坐标）
  mac-ocr ocr 截图.png --lang en-US --level accurate
  mac-ocr ocr 截图.png --debug           另存一张带检测框的调试图
  mac-ocr 截图.png                       省略子命令，等价 mac-ocr ocr 截图.png

说明：
  - 全部本地识别，不联网不上云；模型/语言包下载走国内镜像自动切换
  - OCR 引擎基于 Apple Vision，setup 自动搭建运行环境，识别时自动切换
  - 外部环境注入的确认参数（如 --bypass=...）会被静默忽略，不影响使用
"""

_SETUP_EPILOG = """\
安装内容（全部幂等，可重复跑）：
  1. Tesseract（brew）+ 标准版中文语言包：chi_sim / chi_tra / 简体竖排 / 繁体竖排
  2. vision-ocr：venv + pyobjc（Vision/Quartz/Cocoa，AppKit 在 Cocoa 内），并生成兼容命令
     vision-ocr（默认装到 ~/.local/bin/，旧习惯可直接 vision-ocr 图片.png）
  3. rapidocr：uv tool install rapidocr --with onnxruntime（必须带引擎，否则报
     ImportError: onnxruntime is not installed）

安装路径（默认中性化，可修改）：
  --bin-dir <DIR>     vision-ocr 兼容命令安装目录（默认 ~/.local/bin）
  --venv-dir <DIR>    pyobjc 专用 venv 目录（默认 ~/.local/share/mac-ocr/venv）
  自定义路径装完后，识别/体检需保持对应环境变量（可写 ~/.zshrc 永久生效）：
    export MAC_OCR_BIN_DIR=<DIR>   export MAC_OCR_VENV_DIR=<DIR>

示例：
  mac-ocr setup
  mac-ocr setup --force
  mac-ocr setup --base-url https://gh-proxy.com
  mac-ocr setup --bin-dir ~/bin --venv-dir ~/.venvs/mac-ocr
"""

_OCR_EPILOG = """\
识别语言（--lang）可选值：
  zh-Hans   简体中文（默认，附带英文）
  zh-Hant   繁体中文（附带英文）
  en-US     仅英文
  ja-JP     日文        ko-KR     韩文

说明：
  - 默认 fast 精度，中文效果通常更好；置信度过低会自动回退 accurate
  - --json 输出每条含 text / confidence / bbox 归一化坐标
  - --debug 在图上绘制红色检测框，默认保存为 <原名>_debug.png
"""


def build_parser():
    fmt = argparse.RawDescriptionHelpFormatter
    parser = argparse.ArgumentParser(
        prog="mac-ocr",
        description=(
            "macOS 本地 OCR 三件套统一命令行：\n"
            "  Tesseract（通用兜底）· vision-ocr（Apple Vision，零依赖）· "
            "rapidocr（PP-OCR，中文强）\n"
            "完全本地、隐私安全。一个命令搞定 安装 / 体检 / 识别。"
        ),
        epilog=_MAIN_EPILOG,
        formatter_class=fmt,
    )
    parser.add_argument("--version", action="version", version=f"mac-ocr {VERSION}")
    parser.add_argument("--bypass", default=None, help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="cmd", metavar="<子命令>")

    p_setup = sub.add_parser(
        "setup",
        help="一键安装/修复三件套（幂等）",
        description=(
            "一键安装/修复 macOS 本地 OCR 三件套。幂等设计："
            "缺什么装什么，已就绪的自动跳过，可反复运行。"
        ),
        epilog=_SETUP_EPILOG,
        formatter_class=fmt,
    )
    p_setup.add_argument("--force", action="store_true",
                         help="强制重下已存在的语言包（默认已有则跳过）")
    p_setup.add_argument("--base-url", default=None, metavar="URL",
                         help="指定语言包下载镜像（默认自动探测 ghfast.top / gh-proxy.com）")
    p_setup.add_argument("--bin-dir", default=None, metavar="DIR",
                         help="vision-ocr 兼容命令安装目录（默认 ~/.local/bin）")
    p_setup.add_argument("--venv-dir", default=None, metavar="DIR",
                         help="pyobjc 专用 venv 目录（默认 ~/.local/share/mac-ocr/venv）")
    p_setup.add_argument("--bypass", default=None, help=argparse.SUPPRESS)

    p_check = sub.add_parser(
        "check",
        help="体检三件套就绪状态",
        description=(
            "逐项检查三件套就绪状态：\n"
            "  Tesseract（含标准版中文语言包）/ vision-ocr（Apple Vision）"
            "/ rapidocr（含 onnxruntime 引擎）\n"
            "每项输出 ✅ / ❌ / ⚠️，并给出缺失时的修复提示。"
        ),
        formatter_class=fmt,
    )
    p_check.add_argument("--bypass", default=None, help=argparse.SUPPRESS)

    p_ocr = sub.add_parser(
        "ocr",
        help="用 Apple Vision 识别图片文字",
        description=(
            "调用 macOS 内置 Vision 框架识别图片中的文字，完全本地、"
            "M1 原生加速。默认识别中文+英文。"
        ),
        epilog=_OCR_EPILOG,
        formatter_class=fmt,
    )
    p_ocr.add_argument("image", metavar="图片", help="图片路径（png/jpg/tiff 等）")
    p_ocr.add_argument("--lang", default="zh-Hans", metavar="LANG",
                       help="识别语言，默认 zh-Hans（可选 zh-Hans/zh-Hant/en-US/ja-JP/ko-KR）")
    p_ocr.add_argument("--level", default="fast", choices=["fast", "accurate"],
                       help="识别精度：fast（默认，中文效果通常更好）或 accurate")
    p_ocr.add_argument("--json", action="store_true", dest="json_output",
                       help="JSON 格式输出：每条含 text / confidence / bbox 坐标")
    p_ocr.add_argument("--debug", action="store_true",
                       help="在图上绘制红色检测框，另存为 <原名>_debug.png")
    p_ocr.add_argument("--debug-output", default=None, metavar="PATH",
                       help="调试图片输出路径（配合 --debug 使用）")
    p_ocr.add_argument("--bypass", default=None, help=argparse.SUPPRESS)
    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    # 兼容：mac-ocr 图片.png（第一个非选项参数不是子命令且是文件 → 补 ocr 子命令）
    if argv and not argv[0].startswith("-") and argv[0] not in ("setup", "check", "ocr"):
        argv.insert(0, "ocr")

    parser = build_parser()
    args, _unknown = parser.parse_known_args(argv)

    base_url = getattr(args, "base_url", None)
    if base_url:
        os.environ["BASE_URL"] = base_url

    if args.cmd == "setup":
        return cmd_setup(args)
    if args.cmd == "check":
        return cmd_check(args)
    if args.cmd == "ocr":
        return cmd_ocr(args)

    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
