#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
vision-ocr — Apple Vision 本地 OCR 识别命令

独立识别命令：直接识别图片中的文字（完全本地，M1 原生加速）。
由 `mac-ocr setup` 部署到 ~/.local/bin（PATH 内），任意目录可用。

用法：
  vision-ocr <图片> [选项]

选项：
  --lang <LANG>            识别语言：zh-Hans（默认）/ zh-Hant / en-US / ja-JP / ko-KR
  --level fast|accurate    识别精度（默认 fast，中文效果通常更好）
  --json                   JSON 输出（每条含 text / confidence / bbox 坐标）
  --debug                  另存一张带检测框的调试图（默认 <原名>_debug.png）
  --debug-output <PATH>    调试图输出路径（配合 --debug 使用）

示例：
  vision-ocr 截图.png
  vision-ocr 截图.png --lang en-US --level accurate --json
  vision-ocr 截图.png --debug

说明：
  - 仅依赖 Python 标准库；Apple Vision 引擎需 pyobjc（venv），由 mac-ocr setup 搭建
  - 非 venv 下自动用 venv python 自我重启以加载 pyobjc
  - --bypass 等外部注入的确认参数会被静默忽略，不影响使用
"""

import argparse
import json
import os
import subprocess
import sys

VERSION = "0.1.0"

IN_VENV = os.environ.get("MAC_OCR_IN_VENV") == "1"
VENV_DIR = os.environ.get("MAC_OCR_VENV_DIR", os.path.expanduser("~/.local/share/mac-ocr/venv"))
VENV_PY3 = os.path.join(VENV_DIR, "bin", "python3")

_EPILOG = """\
示例：
  vision-ocr 截图.png                     识别文字（默认中文+英文）
  vision-ocr 截图.png --json              JSON 输出（含置信度/坐标）
  vision-ocr 截图.png --lang en-US --level accurate
  vision-ocr 截图.png --debug             另存一张带检测框的调试图

识别语言（--lang）可选值：
  zh-Hans   简体中文（默认，自动附带英文）
  zh-Hant   繁体中文（自动附带英文）
  en-US     仅英文
  ja-JP     日文        ko-KR     韩文

说明：
  - 完全本地识别，不联网不上云；引擎为 macOS 内置 Vision 框架，M1 原生加速
  - 支持图片格式：PNG / JPEG / TIFF / HEIC / BMP 等（Vision 框架可读即可）
  - 默认输出纯文本（每条一行）；--json 输出结构化结果（text/confidence/bbox）
  - 首次使用前需先跑 mac-ocr setup 搭建 Apple Vision 环境（pyobjc venv）
  - venv 路径默认 ~/.local/share/mac-ocr/venv；export MAC_OCR_VENV_DIR=<DIR> 可覆盖
  - 自动用 venv python 自我重启以加载 pyobjc，无需手动操作
  - 默认 fast 精度，中文效果通常更好；置信度过低会自动回退 accurate
  - --debug 在图上绘制红色检测框，默认保存为 <原名>_debug.png（--debug-output 可指定路径）
  - 退出码：0 成功 / 1 失败（文件不存在、无法读取、环境缺失等）
  - 外部环境注入的确认参数（如 --bypass=...）会被静默忽略，不影响使用
"""


def _venv_has_vision(venv_py: str) -> bool:
    p = subprocess.run([venv_py, "-c", "import Vision"], capture_output=True)
    return p.returncode == 0


def run_engine(args):
    """OCR 引擎主体（仅在有 Vision 的 venv python 中执行）。"""
    import Vision
    from Foundation import NSURL
    from Quartz import CIImage

    LEVEL_FAST = 0
    LEVEL_ACCURATE = 1

    def do_ocr(image, lang="zh-Hans", extra_langs=None, level=LEVEL_FAST):
        request = Vision.VNRecognizeTextRequest.alloc().init()
        request.setRecognitionLevel_(level)
        languages = [lang] + (extra_langs or [])
        if "en-US" not in languages:
            languages.append("en-US")
        request.setRecognitionLanguages_(languages)
        request.setUsesLanguageCorrection_(True)
        handler = Vision.VNImageRequestHandler.alloc().initWithCIImage_options_(image, None)
        success, error = handler.performRequests_error_([request], None)
        if not success:
            return None, error
        results = request.results() or []
        texts = []
        for obs in results:
            bbox = obs.boundingBox()
            texts.append({
                "text": obs.text(),
                "confidence": float(obs.confidence()),
                "bbox": {
                    "x": float(bbox.origin.x),
                    "y": float(bbox.origin.y),
                    "width": float(bbox.size.width),
                    "height": float(bbox.size.height),
                },
            })
        return texts, None

    def ocr_image(image_path, lang="zh-Hans", level="fast"):
        url = NSURL.fileURLWithPath_(os.path.realpath(image_path))
        if not url:
            raise FileNotFoundError(f"找不到文件: {image_path}")
        image = CIImage.imageWithContentsOfURL_(url)
        if not image:
            raise ValueError(f"无法读取图片: {image_path}")
        if level == "accurate":
            results, error = do_ocr(image, lang, None, LEVEL_ACCURATE)
            if error:
                raise RuntimeError(f"OCR 执行失败: {error}")
            return results
        results, error = do_ocr(image, lang, None, LEVEL_FAST)
        if error:
            raise RuntimeError(f"OCR 执行失败: {error}")
        if results:
            avg_conf = sum(r["confidence"] for r in results) / len(results)
            if avg_conf < 0.3:
                results2, _ = do_ocr(image, lang, None, LEVEL_ACCURATE)
                if results2:
                    avg2 = sum(r["confidence"] for r in results2) / len(results2)
                    if avg2 > avg_conf:
                        return results2
        return results

    def debug_image(image_path, results, output_path=None):
        from Quartz import CIContext, CGRectMake
        from AppKit import (NSImage, NSBitmapImageRep, NSBezierPath, NSColor)

        url = NSURL.fileURLWithPath_(os.path.realpath(image_path))
        ci_image = CIImage.imageWithContentsOfURL_(url)
        extent = ci_image.extent()
        img_w, img_h = extent.size.width, extent.size.height
        ci_context = CIContext.context()
        cg_image = ci_context.createCGImage_fromRect_(ci_image, extent)
        ns_image = NSImage.alloc().initWithCGImage_size_(cg_image, extent.size)
        ns_image.lockFocus()
        color = NSColor.redColor()
        for item in results:
            bbox = item["bbox"]
            x = bbox["x"] * img_w
            y = (1.0 - bbox["y"] - bbox["height"]) * img_h
            w = bbox["width"] * img_w
            h = bbox["height"] * img_h
            path_obj = NSBezierPath.bezierPathWithRect_(CGRectMake(x, y, w, h))
            color.setStroke()
            path_obj.setLineWidth_(2.0)
            path_obj.stroke()
        ns_image.unlockFocus()
        if not output_path:
            output_path = os.path.splitext(image_path)[0] + "_debug.png"
        tiff_data = ns_image.TIFFRepresentation()
        bitmap = NSBitmapImageRep.alloc().initWithData_(tiff_data)
        png_data = bitmap.representationUsingType_properties_(4, None)
        png_data.writeToFile_atomically_(output_path, True)
        print(f"调试图片已保存: {output_path}", file=sys.stderr)

    try:
        results = ocr_image(args.image, lang=args.lang, level=args.level)
    except Exception as e:
        print(f"错误: {e}", file=sys.stderr)
        return 1

    if args.debug:
        debug_image(args.image, results, args.debug_output)

    if args.json_output:
        print(json.dumps(results, ensure_ascii=False, indent=2))
    else:
        for item in results:
            print(item["text"])
    return 0


def build_parser():
    fmt = argparse.RawDescriptionHelpFormatter
    parser = argparse.ArgumentParser(
        prog="vision-ocr",
        description=(
            "Apple Vision 本地 OCR 识别命令（macOS 内置框架，完全本地、M1 原生加速）。"
            "默认识别中文+英文。"
        ),
        epilog=_EPILOG,
        formatter_class=fmt,
    )
    parser.add_argument("image", metavar="IMAGE", help="图片路径（png/jpg/tiff 等）")
    parser.add_argument("--lang", default="zh-Hans", metavar="LANG",
                        help="识别语言，默认 zh-Hans（zh-Hans/zh-Hant/en-US/ja-JP/ko-KR，自动附带英文）")
    parser.add_argument("--level", default="fast", choices=["fast", "accurate"],
                        help="识别精度：fast（默认，中文效果通常更好）或 accurate")
    parser.add_argument("--json", action="store_true", dest="json_output",
                        help="JSON 格式输出：每条含 text / confidence / bbox 坐标")
    parser.add_argument("--debug", action="store_true",
                        help="在图上绘制红色检测框，另存为 <原名>_debug.png")
    parser.add_argument("--debug-output", default=None, metavar="PATH",
                        help="调试图片输出路径（仅配合 --debug 生效，默认 <原名>_debug.png）")
    parser.add_argument("--bypass", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--version", action="version", version=f"vision-ocr {VERSION}")
    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    # --version / -h 无需 venv，直接响应
    if "--version" in argv:
        print(f"vision-ocr {VERSION}")
        return 0
    if "-h" in argv or "--help" in argv:
        build_parser().print_help()
        return 0

    # 参数解析与文件检查放在 venv 重启之前：坏参数/文件缺失立即报错，不白白重启 venv
    parser = build_parser()
    args = parser.parse_args(argv)
    if not os.path.isfile(args.image):
        print(f"错误: 文件不存在 - {args.image}", file=sys.stderr)
        return 1

    if IN_VENV:
        return run_engine(args)

    if not os.path.isfile(VENV_PY3):
        print("✘ 需要先跑 mac-ocr setup 搭建 Apple Vision 环境", file=sys.stderr)
        return 1
    if not _venv_has_vision(VENV_PY3):
        print("✘ Apple Vision 环境异常（跑 mac-ocr setup 修复）", file=sys.stderr)
        return 1
    # 自我重启到 venv python（引擎需要 pyobjc/Vision）
    env = dict(os.environ, MAC_OCR_IN_VENV="1")
    p = subprocess.run([VENV_PY3, os.path.realpath(__file__)] + argv, env=env)
    return p.returncode


if __name__ == "__main__":
    sys.exit(main())
